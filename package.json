{
  "name": "lite-ide",
  "version": "1.10.0",
  "description": "Lightweight IDE with Liquid Glass UI",
  "author": "Harshal",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "node build.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test test/wiring.test.js test/backend.test.js test/ai-providers.test.js test/sandbox.test.js test/cancellation.test.js test/budget.test.js test/compaction.test.js test/verification.test.js test/web-tools.test.js test/permissions.test.js test/escalation.test.js test/terminal.test.js test/grep.test.js test/subagents.test.js test/architect.test.js test/architect-logic.test.js test/ui-focus.test.js test/repomap.test.js"
  },

  "build": {
    "appId": "com.liteid.app",
    "productName": "LiteIDE",

    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },

    "asar": true,

    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/monaco-editor/**/*",
      "node_modules/xterm/**/*",
      "node_modules/xterm-addon-fit/**/*"
    ],

    "files": [
      "main.js",
      "preload.js",
      "agent-sandbox.js",
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!dist/**",
      "!**/*.map"
    ],

    "npmRebuild": false,
    "buildDependenciesFromSource": false,

    "win": { "target": ["nsis", "msi", "portable"] },
    "fileAssociations": [
      { "ext": ["py","js","jsx","ts","tsx","json","html","htm","css","md","go","rs","java","c","cpp","h","hpp","rb","php","txt","yml","yaml","sh","xml","sql"], "name": "Code File", "description": "Source file", "role": "Editor" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "target": ["dmg", "zip"]
    },
    "linux": { "category": "Development", "target": ["AppImage", "deb"] }
  },

  "dependencies": {
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },

  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },

  "allowScripts": {
    "electron@42.5.0": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true,
    "nslog@3.2.0": true,
    "node-gyp@12.4.0": true
  }
}
